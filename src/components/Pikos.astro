---
interface Props {
	data: [
        {
            id: string;
            title: string;
            osusumePiko?: true;
        }
    ];
}

import PikosVolume from './Pikos.Volume.astro';

const { data } = Astro.props;
---

<div>
    <table>
        <tbody>
            {data.map(entry => 
            <tr>
                <td>
                    {entry.osusumePiko && <span class="mark">●</span>}<a href={`/mml_id/${entry.id}`}>{entry.title}</a>
                </td>
                <td class="piko-cell">
                    <div class="piko-outer">
                        <div class="piko-inner">
                            <img class="pikoplayer" src="/img/pikoplayer.png" alt={entry.id} />
                        </div>
                    </div>
                </td>
            </tr>
            )}
        </tbody>
    </table>
</div>
<PikosVolume />
<style lang="scss">
table {
    width: 100%;
    max-width: 350px;
    height: 35px;
    margin: 10px auto;
    background-color: #f8f8f8;
    border-radius: 4px;
    color: #111;
    box-shadow: 0 0 5px 0 darkgray;
}
tr + tr {
    border-top: 1px solid #e6e6e6;
}
td {
    border: 0;
    padding: 5px 10px;
}
:global(.mark) {
    margin-right: 2px;
    color: #f6d538;
}
.piko-cell {
    width: 25px;
}
.piko-outer {
    overflow: hidden;
    width: 16px;
    height: 16px;
    margin: 3px 0 0 auto;
    border-radius: 3px;
}
.piko-inner {
    margin-top: -1px;
    margin-left: -1px;
}
.pikoplayer {
    max-width: 86px;
}
</style>