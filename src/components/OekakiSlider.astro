---
interface Props {
	data: [
        {
            id: string;
            title: string;
        }
    ];
    width: number;
    height: number;
}

const { data, width, height } = Astro.props;
---
<div class="wrapper">
    <div class="box" style={{ width: `${width}px` }}>
        <div class="box-inner" style={{ width: `${width}px`, height: `${height}px` }}>
            {data.map(entry => {
                return <a href={`/oekaki_id/${entry.id}`} id={entry.id}>
                    <img src={`/oekaki/${entry.id}.png`} alt={entry.title} title={entry.title} />
                </a>
            })}
        </div>
    </div>
    <div class="tabs" style={{ width: `${width + (10 + 1) * 2}px` }}>
        {data.map(entry => {
            return <a class="tab" href={`#${entry.id}`}>{entry.title}</a>
        })}
        <div class="clear"></div>
    </div>
</div>
<style>
.wrapper {
    overflow: auto;
}
.box {
    border: 1px solid #111;
    padding: 10px;
}
.box-inner {
    overflow: hidden;
}
.tab {
    margin-top: -1px;
    padding: 5px 10px;
    background-color: #fff;
    border: 1px solid #111;
    border-top: none;
    margin-right: 5px;
    text-decoration: none;
    color: #333;
    float: left;
}
.clear {
    clear: both;
}
a {
    display: block;
}
img {
    vertical-align: middle;
}
</style>