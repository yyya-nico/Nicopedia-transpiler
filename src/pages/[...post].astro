---
import Layout from '../layouts/Simple.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
    const posts = await getCollection('posts');
    return posts.map(post => ({
        params: { post: post.data.urlSnippet }, props: { post }
    }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={post.data.title}>
    <h1>{post.data.title}</h1>
    <h2>ニコニコ大百科のリンク集</h2>
    <ul>
        <li><a href={`https://dic.nicovideo.jp/${post.data.urlSnippet}`} target="_blank">記事</a></li>
        <li><a href={`https://dic.nicovideo.jp/p/${post.data.urlSnippet}`} target="_blank">記事更新</a></li>
    </ul>
    <h2>raw</h2>
    <p>
        <a href={`/${post.data.urlSnippet}/raw`}>rawで閲覧</a>
    </p>
    <article>
        <Content />
    </article>
    <button>インライン化済みHTMLをコピー</button>
    <details>
        <summary>インライン化済みHTML</summary>
        <div>
            <output>
                <pre><code></code></pre>
            </output>
        </div>
    </details>
</Layout>
<script>
import juice from 'juice';

const copyBtn = document.querySelector('button')!;
const outputCode = document.querySelector('output code')!;

const rawHTML = await fetch(`${location.pathname}/raw`)
    .then(response => response.text())
    .catch(e => {
        console.error('Failed to fetch raw HTML:', e);
        return '';
    });
const juicedHTML = juice(rawHTML, { inlinePseudoElements: true });
const doc = new DOMParser().parseFromString(juicedHTML, 'text/html');

outputCode.textContent = doc.querySelector('body')?.innerHTML.trim() || '';

copyBtn.addEventListener('click', async () => {
        const textCache = copyBtn.textContent;
        copyBtn.disabled = true;
        navigator.clipboard.writeText(outputCode.textContent || '')
        .then(() => {
            copyBtn.disabled = true;
            copyBtn.textContent = 'コピーしました';
            setTimeout(() => {
                copyBtn.textContent = textCache;
                copyBtn.disabled = false;
            }, 1500);
        })
        .catch(e => alert('コピーできませんでした\n' + e));
    });
</script>